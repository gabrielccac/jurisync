# Documentation template. Python reads exported environment variables.
# Node can load a populated local .env with: node --env-file=.env ...
JURIDIQ_EMAIL=
JURIDIQ_PASSWORD=

# Select the account explicitly in each Juridiq tool call: operational or test.
TEST_JURIDIQ_EMAIL=
TEST_JURIDIQ_PASSWORD=
TEST_JURIDIQ_LAWSUIT_ID=

# Writes require this global opt-in plus tool-level confirmation.
# JURIDIQ_ALLOW_WRITES=true
# RUN_JURIDIQ_WRITE_TEST=true
# TEST_JURIDIQ_SESSION_FILE=C:/path/to/test-account-session.json
# Optional: otherwise cache is stored outside the repo and keyed by email.
# JURIDIQ_SESSION_FILE=C:/path/to/account-specific-session.json
# JURIDIQ_API_BASE_URL=https://api.juridiq.com.br
# JURIDIQ_LOGIN_URL=https://www.api.juridiq.com.br/auth/login

PJE_1G_USERNAME=
PJE_1G_PASSWORD=
PJE_1G_2FA_DATA=
PJE_2G_USERNAME=
PJE_2G_PASSWORD=
PJE_2G_2FA_DATA=
# Shared PJE_USERNAME/PJE_PASSWORD/PJE_2FA_DATA remain fallback options.

# eproc JFSC browser login. Use EPROC_TOTP_SECRET or fall back to the QR at runtime.
EPROC_USERNAME=
EPROC_PASSWORD=
EPROC_TOTP_SECRET=
EPROC_TOTP_ACCOUNT=1
# Optional when the authenticator uses non-default values:
# EPROC_TOTP_ALGORITHM=sha1
# EPROC_TOTP_DIGITS=6

# INSS GERID browser smoke tests. Keep the A3 profile path and TOTP secret local.
# INSS_BROWSER_PROFILE=C:/path/to/chrome-user-data
# INSS_BROWSER_PROFILE_DIRECTORY=Profile 3
# INSS_BROWSER_CHANNEL=chrome
# INSS_GERID_TOTP_SECRET=
# INSS_GERID_TOTP_ACCOUNT=1
# INSS_GERID_OTP=
# INSS_RECAPTCHA_SITE_KEY=6LfA-t8oAAAAAAMYMMHDthsSTek1eOYMwyjJcvoK
# INSS_RECAPTCHA_ACTION=buscaRequerimentos
