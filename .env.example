# Copy to .env and fill only the connectors you use. Every MCP server in
# .mcp.json loads this file at startup (via JURISYNC_ENV_FILE); variables
# already set in the environment take precedence. Never commit .env.

# --- Juridiq -----------------------------------------------------------------
JURIDIQ_EMAIL=
JURIDIQ_PASSWORD=
# Write tools are registered only when this is true.
JURIDIQ_ALLOW_WRITES=false
# JURIDIQ_SESSION_FILE=/private/path/juridiq-session.json   (default: ~/.cache/jurisync/juridiq/, keyed by email)
# JURIDIQ_API_BASE_URL=https://api.juridiq.com.br
# JURIDIQ_LOGIN_URL=https://www.api.juridiq.com.br/auth/login

# --- ADVBOX (plain HTTP session; the device must already be approved by email) ---
ADVBOX_EMAIL=
ADVBOX_PASSWORD=
ADVBOX_DEVICE_ID=
ADVBOX_ALLOW_WRITES=false
# ADVBOX_UPLOAD_FOLDER=files/temp/<user-id>   (optional: read from the logged-in session when unset)
# JURISYNC_DOCUMENTS_DIR=~/.local/share/jurisync/documents   (documents saved by pje_read_documents, attached by name)
# ADVBOX_SESSION_FILE=data/advbox-session.json
# ADVBOX_TIMEOUT_SECONDS=60
# ADVBOX_MAX_DOWNLOAD_BYTES=52428800
# ADVBOX_MAX_PDF_TEXT_CHARS=500000

# --- PJe TRF1 (username/password + TOTP; 1G and 2G accounts are independent) ---
# *_2FA_DATA accepts an otpauth:// URI, a Google Authenticator export, or a raw secret.
# With a multi-account export, pick one by name/issuer match or zero-based index.
PJE_1G_USERNAME=
PJE_1G_PASSWORD=
PJE_1G_2FA_DATA=
PJE_1G_OTP_PROFILE_MATCH=
PJE_1G_OTP_PROFILE_INDEX=
PJE_2G_USERNAME=
PJE_2G_PASSWORD=
PJE_2G_2FA_DATA=
PJE_2G_OTP_PROFILE_MATCH=
PJE_2G_OTP_PROFILE_INDEX=

# --- PJe TJAP 1G (password + TOTP; state court served under /1g/) --------------
TJAP_1G_USERNAME=
TJAP_1G_PASSWORD=
TJAP_1G_2FA_DATA=
TJAP_1G_OTP_PROFILE_MATCH=
TJAP_1G_OTP_PROFILE_INDEX=

# --- PJe TRF5 1G/JEF (A1 certificate + TOTP; valid only on trf5-1g) -----------
PJE_A1_PIN=
# PJE_A1_P12=/private/path/a1.p12   (required for TRF5; set per customer in customers/<name>/.env)
# Set one of these two:
# PJE_TRF5_2FA_DATA=
# PJE_TRF5_2FA_QR=/private/path/authenticator-qr.png
# Stable account label; enables reusing TRF5 cookies across server restarts.
# PJE_TRF5_1G_SESSION_ACCOUNT=
# PJE_SESSION_DIR=/private/path/pje-sessions   (default: ~/.cache/jurisync/pje)

# PJe 1st-degree draft filing, TRF5 and TRF1 (creates/fills drafts in Não Protocolados; never protocols).
PJE_ALLOW_DRAFT_WRITES=false
# Filing data: inputs/ (exporter folders) and runs/ (assembled runs). Default: ~/.local/share/jurisync/filing
# JURISYNC_FILING_DIR=/private/path/filing
# Days a run without a draft is kept before pje_filing_cleanup may remove it (default 30).
# JURISYNC_FILING_RETENTION_DAYS=30
# Seconds to keep rereading the draft for an attachment already sent before sending it again (default 90).
# PJE_UPLOAD_SETTLE_SECONDS=90

# --- Eproc JFSC / JFRS (browser login + TOTP; one account per portal) ----------
# JFRS_* replaced the misspelled JRFS_*; old JRFS_* variables are still read.
JFSC_USUARIO=
JFSC_SENHA=
JFSC_EXPORT_DATA=
JFSC_OTP_PROFILE_MATCH=
JFSC_OTP_PROFILE_INDEX=
JFRS_USUARIO=
JFRS_SENHA=
JFRS_EXPORT_DATA=
JFRS_OTP_PROFILE_MATCH=
JFRS_OTP_PROFILE_INDEX=

# --- Eproc TJRS 1G (browser login + TOTP; state court) --------------------------
TJRS_1G_USERNAME=
TJRS_1G_PASSWORD=
TJRS_1G_2FA_DATA=
TJRS_1G_OTP_PROFILE_MATCH=
TJRS_1G_OTP_PROFILE_INDEX=

# --- INSS GERID (Chrome profile holding the A3 certificate + TOTP) -------------
# INSS_BROWSER_PROFILE=/private/path/chrome-user-data   (default: data/inss-browser-profile)
# INSS_BROWSER_PROFILE_DIRECTORY=Profile 3
# INSS_CHROME_PATH=/usr/bin/google-chrome
# Provide the TOTP as a secret, a one-time code, or a QR image:
# INSS_GERID_TOTP_SECRET=
# INSS_GERID_OTP=
# INSS_GERID_QR_IMAGE=/private/path/QR_gerid.png
# INSS_GERID_TOTP_ACCOUNT=1
# INSS_GERID_TIMEOUT_SECONDS=180
# INSS_PDF_OCR=true            (local OCR for scanned pages; false to disable)
# INSS_MAX_PDF_TEXT_CHARS=500000
# INSS_DOWNLOAD_DIR=/private/path/inss-downloads   (default: downloaded_files/inss)

# --- PDF OCR (optional; pdf-inspector falls back to text extraction without it) ---
# PDFIUM_LIB_PATH=/path/to/libpdfium.so
# ORT_DYLIB_PATH=/path/to/libonnxruntime.so
# PDF_INSPECTOR_MODEL_CACHE=/path/to/model-cache

# --- Google Drive exporter (read-only service account) -------------------------
# Key of the service account the client folders are shared with (default shown); must be chmod 600.
# GOOGLE_SERVICE_ACCOUNT_FILE=~/.config/jurisync/google-service-account.json

# --- Customer: Victor --------------------------------------------------------
# Document classification for filing prep (sends filename + ≤12,000 text characters).
# OPENROUTER_API_KEY=
# TYPESAFE_API_KEY=
# LIBREOFFICE_BIN=libreoffice
