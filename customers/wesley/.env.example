# Copy to customers/wesley/.env (gitignored) and fill in. Run: uv run python -m jurisync.customers wesley
# Prefix = portal key uppercased (PJE_1G_* for trf1-1g).
# <PREFIX>_CERT=true: log in with the A1 certificate. trf5-1g always does.
# TRF1 1G asks for no TOTP after the certificate; TRF1 2G and TRF5 do (same authenticator profile).
PJE_1G_CERT=true
PJE_2G_CERT=true
PJE_2G_2FA_DATA=
PJE_TRF5_1G_2FA_DATA=
PJE_TRF3_1G_CERT=true
PJE_TRF3_1G_2FA_DATA=
# Optional: lets the PJe session cache be reused between runs (the certificate is not an identity).
# PJE_TRF5_1G_SESSION_ACCOUNT=

# A1 certificate (e-CPF). File must be gitignored; PIN is the certificate password.
PJE_A1_P12=/private/path/A1_PF_WESLEY.pfx
PJE_A1_PIN=

# Juridiq (not a court portal; lives only in .env).
JURIDIQ_EMAIL=
JURIDIQ_PASSWORD=

# Eproc TRF4 (A1 certificate over mutual TLS + the Eproc/TRF4 authenticator profile).
TRF4_2G_CERT=true
# TRF4_2G_2FA_QR=/private/path/QR_Wesley_Eproc.jpeg
TRF4_2G_OTP_PROFILE_MATCH=TRF4
# The TRF4 1G sections (SC, RS, PR) use the same certificate and the same Eproc/TRF4 profile.
TRF4_1G_SC_CERT=true
TRF4_1G_SC_2FA_QR=/private/path/QR_Wesley_Eproc.jpeg
TRF4_1G_SC_OTP_PROFILE_MATCH=TRF4
TRF4_1G_RS_CERT=true
TRF4_1G_RS_2FA_QR=/private/path/QR_Wesley_Eproc.jpeg
TRF4_1G_RS_OTP_PROFILE_MATCH=TRF4
TRF4_1G_PR_CERT=true
TRF4_1G_PR_2FA_QR=/private/path/QR_Wesley_Eproc.jpeg
TRF4_1G_PR_OTP_PROFILE_MATCH=TRF4
# TRF6 (1G and 2G share TRF6_*): user, password and the Eproc/TRF6 profile (no certificate login there).
TRF6_USERNAME=
TRF6_PASSWORD=
TRF6_2FA_QR=/private/path/QR_Wesley_Eproc.jpeg
TRF6_OTP_PROFILE_MATCH=TRF6
