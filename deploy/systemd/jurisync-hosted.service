[Unit]
Description=Jurisync hosted MCP server (one /mcp for every office)
Documentation=file:///opt/jurisync/app/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jurisync
Group=jurisync
EnvironmentFile=/etc/jurisync/jurisync.env
# Written by quick-tunnel.sh while the server runs on a temporary trycloudflare.com address.
EnvironmentFile=-/etc/jurisync/base-url.env
WorkingDirectory=/var/lib/jurisync
# The code in /opt/jurisync/app is root's and read-only here: sessions and downloads go to the state folder.
Environment=JURISYNC_STATE_DIR=/var/lib/jurisync PYTHONDONTWRITEBYTECODE=1
# OCR of scanned PDFs: the models install.sh fetched, root's and read-only here (reads never download).
# JURISYNC_OCR=off in /etc/jurisync/jurisync.env switches OCR off.
Environment=PDF_INSPECTOR_MODEL_CACHE=/opt/jurisync/models
# The vault key (and the CAPTCHA key) come as systemd credentials: install.sh adds
# jurisync-hosted.service.d/credentials.conf with LoadCredentialEncrypted= (or LoadCredential= without systemd-creds).
# They are read from $CREDENTIALS_DIRECTORY, never from the environment or this file.
ExecStart=/opt/jurisync/app/.venv/bin/jurisync-hosted serve --base-url ${JURISYNC_BASE_URL} --host 127.0.0.1 --port ${JURISYNC_PORT}
Restart=on-failure
RestartSec=5
# Pending OAuth sign-ins live in memory: one process only.
LimitNOFILE=65536
MemoryMax=6G
TasksMax=2048

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/jurisync
UMask=0077

[Install]
WantedBy=multi-user.target
