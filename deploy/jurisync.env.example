# /etc/jurisync/jurisync.env: settings of the hosted server, no secrets (install.sh writes it; 0640 root:jurisync).
# Secrets (vault key, CAPTCHA key) are systemd credentials: see set-secret.sh.

# Public address: the OAuth issuer and the URL offices add in Claude/ChatGPT (+ /mcp). Must match what the proxy serves.
JURISYNC_BASE_URL=https://mcp.example.com.br
JURISYNC_PORT=8080

# State: store.sqlite + vault/ (backed up daily), customer profiles (provision apply installs them).
JURISYNC_HOSTED_DIR=/var/lib/jurisync/hosted
JURISYNC_CUSTOMERS_DIR=/var/lib/jurisync/customers
HOME=/var/lib/jurisync

# Logins: at most 2 at once in the process (each Eproc browser_totp login is a headless Chrome, ~300 MB).
JURISYNC_MAX_LOGINS=2
JURISYNC_LOGIN_COOLDOWN_SECONDS=900
# Set to 1 after Claude and ChatGPT sign-ins were seen sending the token resource (docs/hosted.md).
JURISYNC_REQUIRE_TOKEN_RESOURCE=0

JURISYNC_CHROME_PATH=/usr/bin/google-chrome
LIBREOFFICE_BIN=/usr/bin/soffice
