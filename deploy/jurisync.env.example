# /etc/jurisync/jurisync.env: settings of the hosted server, no secrets (install.sh writes it; 0640 root:jurisync).
# Secrets (vault key, CAPTCHA key) are systemd credentials: see set-secret.sh.

# Public address: the OAuth issuer and the URLs offices add in Claude/ChatGPT (+ /tribunais/mcp, /advbox/mcp, /juridiq/mcp). Must match what the proxy serves.
JURISYNC_BASE_URL=https://mcp.example.com.br
JURISYNC_PORT=8080

# State: store.sqlite + vault/ (backed up daily), customer profiles (provision apply installs them), and the connectors'
# sessions and downloads (data/, downloaded_files/). The code in /opt/jurisync/app is read-only for the service.
JURISYNC_HOSTED_DIR=/var/lib/jurisync/hosted
JURISYNC_CUSTOMERS_DIR=/var/lib/jurisync/customers
JURISYNC_STATE_DIR=/var/lib/jurisync
HOME=/var/lib/jurisync

# Logins: at most 2 at once in the process (each Eproc browser_totp login is a headless Chrome, ~300 MB).
JURISYNC_MAX_LOGINS=2
JURISYNC_LOGIN_COOLDOWN_SECONDS=900
# Longest wait for a login slot and for the office's own call on the same portal before the call fails clearly.
JURISYNC_LOGIN_WAIT_SECONDS=300
JURISYNC_SESSION_WAIT_SECONDS=600
# Set to 1 after Claude and ChatGPT sign-ins were seen sending the token resource (docs/hosted.md).
JURISYNC_REQUIRE_TOKEN_RESOURCE=0
# OAuth clients may register redirects only to Claude, ChatGPT or localhost. Other https hosts that may receive sign-in
# codes, comma separated (the sign-in page still warns about them). A client already registered elsewhere stops working.
#JURISYNC_OAUTH_REDIRECT_HOSTS=

JURISYNC_CHROME_PATH=/usr/bin/google-chrome
LIBREOFFICE_BIN=/usr/bin/soffice

# OCR of scanned PDFs (pdf-ocr extra; models fetched by install.sh into /opt/jurisync/models, which the unit names in
# PDF_INSPECTOR_MODEL_CACHE). On by default; off is the kill switch: scanned documents then come back as ocr_needed.
JURISYNC_OCR=on
# Bounds per document: pages read and seconds before no new page batch starts.
#JURISYNC_OCR_MAX_PAGES=30
#JURISYNC_OCR_SECONDS=90
